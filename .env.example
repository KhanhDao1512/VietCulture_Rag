# LLM provider: vilao (default) or gemini
LLM_PROVIDER=vilao
LLM_BASE_URL=https://api.vilao.ai/v1
LLM_API_KEY=replace_with_your_vilao_api_key
LLM_MODEL=chib/deepseek-v4.1-flash

# Optional Gemini configuration when LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face token is optional for public models/datasets; useful for gated assets/rate limits
HF_TOKEN=

# Chroma / retrieval
QA_RETRIEVER_PROFILE=legacy
QA_CHROMA_DIR=vector_index
QA_CHROMA_COLLECTION=vietculture_topic_qa_v1
QA_RETRIEVER_DEVICE=cpu
QA_TOP_K=5
QA_FETCH_K=50
QA_EMBED_MODEL=intfloat/multilingual-e5-base

# Local SQLite transcript store (ignored by Git)
CONVERSATION_DB=conversations.sqlite3

# LLM intent fallback
USE_LLM_INTENT_ROUTER=false
LLM_INTENT_CONFIDENCE_THRESHOLD=0.75
